[run]
source = .
branch = True
omit =
    tests/*
    */__pycache__/*
    # Prompt libraries are data - long string constants with no branches.
    # Counting them drags the number around without saying anything about
    # whether the code that uses them is exercised.
    utils/prompts.py
    utils/prompts_no_hallucination_reviewed.py
    utils/categories*.py
    utils/predict_category_list.py
    # Measurement harnesses, not runtime code. They exist to call live models
    # and write a committed JSON; there is nothing here a unit test can run.
    # The pure scoring they rely on lives in tools/skill_eval_scoring.py,
    # which is counted and tested.
    tools/measure_*.py

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
